t.ts\\\" \\\"src/logic-functions/__tests__/*.test.ts\\\"\"\n  },\n  \"devDependencies\": {\n    \"@types/node\": \"^24.7.2\",\n    \"@types/react\": \"^19.0.0\",\n    \"oxlint\": \"^0.16.0\",\n    \"react\": \"^19.0.0\",\n    \"react-dom\": \"^19.0.0\",\n    \"twenty-client-sdk\": \"2.31.0\",\n    \"twenty-sdk\": \"2.31.0\",\n    \"typescript\": \"^5.9.3\"\n  }\n}\n```\n\n`/Users/maxaubert/Projets/A2E Suite/packages/twenty-apps/internal/a2e-documents/package.json` is identical except `name`, `version: \"0.2.0\"`, and it **omits `test:unit`** (its tests are run manually). For `a2e-chat`, copy the projects version and add `test:unit`.\n\n### 2b. `tsconfig.json` (identical in both)\n\n```json\n{\n  \"compileOnSave\": false,\n  \"compilerOptions\": {\n    \"noEmit\": true,\n    \"jsx\": \"react-jsx\",\n    \"moduleResolution\": \"bundler\",\n    \"allowImportingTsExtensions\": true,\n    \"allowSyntheticDefaultImports\": true,\n    \"emitDecoratorMetadata\": true,\n    \"experimentalDecorators\": true,\n    \"importHelpers\": true,\n    \"allowUnreachableCode\": false,\n    \"strict\": true,\n    \"alwaysStrict\": true,\n    \"noImplicitAny\": true,\n    \"strictBindCallApply\": false,\n    \"target\": \"es2022\",\n    \"module\": \"esnext\",\n    \"lib\": [\"es2023\", \"dom\"],\n    \"types\": [\"node\"],\n    \"skipLibCheck\": true,\n    \"skipDefaultLibCheck\": true,\n    \"resolveJsonModule\": true,\n    \"paths\": {\n      \"src/*\": [\"./src/*\"],\n      \"~/*\": [\"./*\"]\n    }\n  },\n  \"exclude\": [\"node_modules\", \"dist\"]\n}\n```\n\n### 2c. `.oxlintrc.json` (identical in both)\n\n```json\n{\n  \"$schema\": \"./node_modules/oxlint/configuration_schema.json\",\n  \"plugins\": [\"typescript\"],\n  \"categories\": {\n    \"correctness\": \"off\"\n  },\n  \"ignorePatterns\": [\"node_modules\", \"dist\"],\n  \"rules\": {\n    \"no-unused-vars\": \"off\",\n\n    \"typescript/no-unused-vars\": [\n      \"warn\",\n      { \"argsIgnorePattern\": \"^_\" }\n    ],\n    \"typescript/no-explicit-any\": \"off\"\n  },\n  \"overrides\": [\n    {\n      \"files\": [\"**/*.logic-function.ts\", \"**/logic-functions/**/*.ts\"],\n      \"rules\": {\n        \"no-restricted-imports\": [\n          \"error\",\n          {\n            \"patterns\": [\n              {\n                \"group\": [\"twenty-shared\", \"twenty-shared/*\"],\n                \"message\": \"Logic functions must not import from twenty-shared directly. Import runtime types and helpers from `twenty-sdk/logic-function` instead so the logic-function bundle stays minimal.\"\n              }\n            ]\n          }\n        ]\n      }\n    }\n  ]\n}\n```\n\nThere is also a base config at `/Users/maxaubert/Projets/A2E Suite/packages/twenty-apps/.oxlintrc.base.json` that bans `twenty-shared` imports for all apps (the app's own override narrows it to logic functions).\n\n### 2d. `.nvmrc`\n\n```\n24.5.0\n```\n\n### 2e. `.yarnrc.yml`\n\n```yaml\nnodeLinker: node-modules\n```\n\n### 2f. `.gitignore` (identical in both)\n\n```gitignore\n# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.\n\n# dependencies\n/node_modules\n/.pnp\n.pnp.*\n.yarn\n\n# codegen\ngenerated\n\n# testing\n/coverage\n/e2e/.auth\n/e2e/.results\n/playwright-report\n/test-results\n\n# dev\n/dist/\n\n.twenty\n\n# production\n/build\n\n# misc\n.DS_Store\n*.pem\n\n# debug\nnpm-debug.log*\nyarn-debug.log*\nyarn-error.log*\n.pnpm-debug.log*\n\n# env files (can opt-in for committing if needed)\n.env*\n\n# typescript\n*.tsbuildinfo\n*.d.ts\n```\n\n### 2g. `application.config.ts`\n\n`/Users/maxaubert/Projets/A2E Suite/packages/twenty-apps/internal/a2e-documents/src/application.config.ts`:\n\n```ts\nimport { defineApplication } from 'twenty-sdk/define';\n\nexport const APPLICATION_UNIVERSAL_IDENTIFIER =\n  '19126a9c-7cc0-4368-aaba-c7e5a87b0c48';\n\nexport default defineApplication({\n  universalIdentifier: APPLICATION_UNIVERSAL_IDENTIFIER,\n  displayName: 'A2E Documents',\n  description:\n    'Workspace documents: hierarchical doc tree with rich-text editing, templates and sharing',\n});\n```\n\n`a2e-projects` version:\n\n```ts\nimport { defineApplication } from 'twenty-sdk/define';\n\nexport const APPLICATION_UNIVERSAL_IDENTIFIER =\n  '4f759655-84f8-434d-9c76-ee1850e8c1a4';\n\nexport default defineApplication({\n  universalIdentifier: APPLICATION_UNIVERSAL_IDENTIFIER,\n  displayName: 'A2E Projects',\n  description:\n    'Projets & tâches 2.0 : projets, statuts, gantt et suivi du temps sur le moteur de tâches natif',\n});\n```\n\nPer `README-A2E.md` §\"Creating an internal app\": generate the application UUID and the role UUID once with `node -e \"console.log(crypto.randomUUID())\"`, commit immediately, never regenerate. The `displayName` is the product name (e.g. \"A2E Chat\"), package name is `a2e-chat`.\n\n### 2h. Default role — `src/roles/default-function.role.ts`\n\n`/Users/maxaubert/Projets/A2E Suite/packages/twenty-apps/internal/a2e-documents/src/roles/default-function.role.ts`:\n\n```ts\nimport { defineApplicationRole } from 'twenty-sdk/define';\n\nexport const DEFAULT_FUNCTION_ROLE_UNIVERSAL_IDENTIFIER =\n  '1e0eda2a-8319-4211-93f7-e0e185ee35b1';\n\nexport default defineApplicationRole({\n  universalIdentifier: DEFAULT_FUNCTION_ROLE_UNIVERSAL_IDENTIFIER,\n  label: 'A2E Documents default function role',\n  description: 'Role the A2E Documents app operations run as',\n  canReadAllObjectRecords: true,\n  canUpdateAllObjectRecords: true,\n  canSoftDeleteAllObjectRecords: true,\n  canDestroyAllObjectRecords: false,\n});\n```\n\n`a2e-projects` is identical with UUID `9b6621c5-0521-4421-b97c-d10b1b9da38d` and labels `A2E Projects …`.\n\nImportant constraint recorded in `docs/plan/phases/phase-04-report.md` (line 171): the SDK allows **only ONE `defineApplicationRole` per app**. If a second assignable role is needed, use `defineRole` (as `a2e-accounting` does with `finance-user.role.ts`).\n\n---\n\n## 3. Object and field declaration format\n\n### 3a. Object — `defineObject`\n\n`/Users/maxaubert/Projets/A2E Suite/packages/twenty-apps/internal/a2e-documents/src/objects/document.object.ts` (embedded fields, relations to app objects and standard objects):\n\n```ts\nimport {\n  defineObject,\n  FieldType,\n  OnDeleteAction,\n  STANDARD_OBJECT_UNIVERSAL_IDENTIFIERS,\n} from 'twenty-sdk/define';\n\nimport {\n  documentKindOptions,\n  documentTagOptions,\n  manyToOne,\n  oneToMany,\n} from '../constants/field-vocabulary.ts';\nimport {\n  LABEL_IDENTIFIER_IDS,\n  OBJECT_IDS,\n  RELATION_IDS,\n} from '../constants/universal-identifiers.ts';\n\nexport default defineObject({\n  universalIdentifier: OBJECT_IDS.document,\n  nameSingular: 'document',\n  namePlural: 'documents',\n  labelSingular: 'Document',\n  labelPlural: 'Documents',\n  description:\n    'Document de l’espace de travail : arborescence, contenu riche, modèle, favoris et corbeille.',\n  icon: 'IconNotes',\n  labelIdentifierFieldMetadataUniversalIdentifier:\n    LABEL_IDENTIFIER_IDS.documentTitle,\n  fields: [\n    {\n      universalIdentifier: LABEL_IDENTIFIER_IDS.documentTitle,\n      type: FieldType.TEXT,\n      name: 'title',\n      label: 'Titre',\n      icon: 'IconAbc',\n      defaultValue: \"''\",\n    },\n    {\n      universalIdentifier: 'c31a0100-0001-4000-8000-000000000003',\n      type: FieldType.SELECT,\n      name: 'kind',\n      label: 'Type',\n      icon: 'IconFileText',\n      defaultValue: `'DOCUMENT'`,\n      options: documentKindOptions,\n    },\n    // ... more fields ...\n    {\n      universalIdentifier: RELATION_IDS.documentCompany,\n      type: FieldType.RELATION,\n      name: 'company',\n      label: 'Entreprise liée',\n      icon: 'IconBuildingSkyscraper',\n      relationTargetObjectMetadataUniversalIdentifier:\n        STANDARD_OBJECT_UNIVERSAL_IDENTIFIERS.company.universalIdentifier,\n      relationTargetFieldMetadataUniversalIdentifier:\n        RELATION_IDS.companyDocuments,\n      universalSettings: {\n        ...manyToOne('companyId'),\n        onDelete: OnDeleteAction.SET_NULL,\n      },\n    },\n  ],\n});\n```\n\n### 3b. Standalone field — `defineField`\n\nUsed for cross-object relation fields (fields added to standard objects or inverse sides that must live on another object). `/Users/maxaubert/Projets/A2E Suite/packages/twenty-apps/internal/a2e-projects/src/fields/task-project.field.ts`:\n\n```ts\nimport {\n  defineField,\n  FieldType,\n  OnDeleteAction,\n  RelationType,\n  STANDARD_OBJECT_UNIVERSAL_IDENTIFIERS,\n} from 'twenty-sdk/define';\n\nimport { OBJECT_IDS, TASK_FIELD_IDS } from '../constants/universal-identifiers.ts';\n\nexport default defineField({\n  universalIdentifier: TASK_FIELD_IDS.project,\n  objectUniversalIdentifier:\n    STANDARD_OBJECT_UNIVERSAL_IDENTIFIERS.task.universalIdentifier,\n  type: FieldType.RELATION,\n  name: 'project',\n  label: 'Projet',\n  description: 'Projet auquel cette tâche appartient',\n  icon: 'IconKanban',\n  isNullable: true,\n  relationTargetObjectMetadataUniversalIdentifier: OBJECT_IDS.project,\n  relationTargetFieldMetadataUniversalIdentifier:\n    TASK_FIELD_IDS.tasksOnProject,\n  universalSettings: {\n    relationType: RelationType.MANY_TO_ONE,\n    joinColumnName: 'projectId',\n    onDelete: OnDeleteAction.SET_NULL,\n  },\n});\n```\n\nA simple SELECT field on a standard object (`task-priority.field.ts`, same dir):\n\n```ts\nexport default defineField({\n  universalIdentifier: TASK_FIELD_IDS.priority,\n  objectUniversalIdentifier:\n    STANDARD_OBJECT_UNIVERSAL_IDENTIFIERS.task.universalIdentifier,\n  type: FieldType.SELECT,\n  name: 'priority',\n  label: 'Priorité',\n  icon: 'IconFlag',\n  isNullable: true,\n  options: [\n    { id: 'c31b0201-0005-4000-8000-000000000061', value: 'URGENT', label: 'Urgent', position: 0, color: 'red' },\n    // ...\n  ],\n});\n```\n\nAn inverse relation owned by the standard `company` object (`a2e-documents/src/fields/company-documents.field.ts`) hardcodes the standard company UUID:\n\n```ts\nexport default defineField({\n  universalIdentifier: RELATION_IDS.companyDocuments,\n  name: 'documents',\n  label: 'Documents',\n  type: FieldType.RELATION,\n  objectUniversalIdentifier: '20202020-b374-4779-a561-80086cb2e17f', // company\n  relationTargetObjectMetadataUniversalIdentifier: OBJECT_IDS.document,\n  relationTargetFieldMetadataUniversalIdentifier: RELATION_IDS.documentCompany,\n  universalSettings: { relationType: RelationType.ONE_TO_MANY },\n});\n```\n\n### 3c. `STANDARD_OBJECT_UNIVERSAL_IDENTIFIERS`\n\nRe-exported by `twenty-sdk/define` from:\n\n`/Users/maxaubert/Projets/A2E Suite/packages/twenty-shared/src/metadata/constants/standard-object-universal-identifiers.constant.ts`\n\n```ts\nexport const STANDARD_OBJECT_UNIVERSAL_IDENTIFIERS = {\n  timelineActivity: '20202020-6736-4337-b5c4-8b39fae325a5',\n  attachment: '20202020-bd3d-4c60-8dca-571c71d4447a',\n  blocklist: '20202020-0408-4f38-b8a8-4d5e3e26e24d',\n  calendarChannelEventAssociation: '20202020-491b-4aaa-9825-afd1bae6ae00',\n  calendarEvent: '20202020-8f1d-4eef-9f85-0d1965e27221',\n  calendarEventTarget: '6a9b9656-3e23-4234-94a4-b913c5dde668',\n  calendarEventParticipant: '20202020-a1c3-47a6-9732-27e5b1e8436d',\n  callRecording: 'ce19efb9-710f-45b2-b141-473abbeea60b',\n  noteTarget: '20202020-fff0-4b44-be82-bda313884400',\n  taskTarget: '20202020-5a9a-44e8-95df-771cd06d0fb1',\n  person: '20202020-e674-48e5-a542-72570eee7213',\n  company: '20202020-b374-4779-a561-80086cb2e17f',\n  opportunity: '20202020-9549-49dd-b2b2-883999db8938',\n  note: '20202020-0b00-45cd-b6f6-6cd806fc6804',\n  task: '20202020-1ba1-48ba-bc83-ef7e5990ed10',\n  workflow: '20202020-62be-406c-b9ca-8caa50d51392',\n  workflowAutomatedTrigger: '20202020-3319-4234-a34c-7f3b9d2e4d1f',\n  workflowVersion: '20202020-d65d-4ab9-9344-d77bfb376a3d',\n  workflowRun: '20202020-4e28-4e95-a9d7-6c00874f843c',\n  workspaceMember: '20202020-3319-4234-a34c-82d5c0e881a6',\n  dashboard: '20202020-3840-4b6d-9425-0c5188b05ca8',\n  message: '20202020-3f6b-4425-80ab-e468899ab4b2',\n  messageChannelMessageAssociation: '20202020-ad1e-4127-bccb-d83ae04d2ccb',\n  // ...\n  messageList: '826561ea-4816-411c-baa0-eec5e6ca8866',\n  messageListMember: '27773d24-8ce3-40f8-aa6c-1f590f2c08d2',\n  messageCampaign: '238acb94-dd4c-4036-bc55-19b99d821efd',\n  messageParticipant: '20202020-a433-4456-aa2d-fd9cb26b774a',\n  messageThread: '20202020-849a-4c3e-84f5-a25a7d802271',\n  messageThreadTarget: '378ad1b0-592d-4084-80ee-86fef44725b9',\n} as const;\n```\n\nFor `a2e-chat`, the native `message`, `messageThread`, `messageParticipant`, `messageChannelMessageAssociation` primitives already exist and are referenced through this map.\n\n### 3d. Relation vocabulary helpers\n\n`/Users/maxaubert/Projets/A2E Suite/packages/twenty-apps/internal/a2e-projects/src/constants/field-vocabulary.ts`:\n\n```ts\nimport { FieldType, RelationType } from 'twenty-sdk/define';\n\ntype OptionColor = 'red' | 'ruby' | ... | 'gray';\n\nconst option = (suffix, value, label, position, color) => ({\n  id: `c31b0200-0005-4000-8000-0000000000${suffix}`,\n  value, label, position, color,\n});\n\nexport const projectStatusOptions = [\n  option('01', 'PLANNING', 'Planification', 0, 'sky'),\n  // ...\n];\n\nexport const RELATION = FieldType.RELATION;\nexport const oneToMany = { relationType: RelationType.ONE_TO_MANY } as const;\nexport const manyToOne = (joinColumnName: string) =>\n  ({ relationType: RelationType.MANY_TO_ONE, joinColumnName }) as const;\n```\n\n`OptionColor` is defined locally because the SDK keeps `TagColor` un-exported. Select options use `id` in objects and `universalIdentifier` in standalone/embedded fields; both are accepted (tests read `option.id ?? option.universalIdentifier`).\n\n---\n\n## 4. Views, page-layouts, navigation, command menu\n\n### 4a. View — `defineView`\n\n`/Users/maxaubert/Projets/A2E Suite/packages/twenty-apps/internal/a2e-documents/src/views/all-documents.view.ts` (TABLE with derived view-field ids and a sort):\n\n```ts\nimport {\n  defineView,\n  ViewOpenRecordIn,\n  ViewSortDirection,\n  ViewType,\n} from 'twenty-sdk/define';\n\nimport { OBJECT_IDS, VIEW_IDS, viewFieldId } from '../constants/universal-identifiers.ts';\n\nconst field = {\n  title: 'c31a0100-0001-4000-8000-000000000001',\n  kind: 'c31a0100-0001-4000-8000-000000000003',\n  tags: 'c31a0100-0001-4000-8000-000000000008',\n  archivedAt: 'c31a0100-0001-4000-8000-000000000009',\n};\n\nconst fieldId = (viewIndex: number) => (position: number) =>\n  viewFieldId(viewIndex, position);\nconst id = fieldId(0);\n\nexport default defineView({\n  universalIdentifier: VIEW_IDS.allDocuments,\n  name: 'Tous les documents',\n  objectUniversalIdentifier: OBJECT_IDS.document,\n  type: ViewType.TABLE,\n  icon: 'IconNotes',\n  position: 0,\n  openRecordIn: ViewOpenRecordIn.SIDE_PANEL,\n  fields: [\n    {\n      universalIdentifier: id(0),\n      fieldMetadataUniversalIdentifier: field.title,\n      position: 0,\n      isVisible: true,\n      size: 280,\n    },\n    // ...\n  ],\n  sorts: [\n    {\n      universalIdentifier: 'c31a0100-0006-4000-8000-000000000001',\n      fieldMetadataUniversalIdentifier: field.title,\n      direction: ViewSortDirection.ASC,\n    },\n  ],\n});\n```\n\nKANBAN view (`a2e-projects/src/views/task-board.view.ts`) adds `mainGroupByFieldMetadataUniversalIdentifier`, `filters`, and `groups`:\n\n```ts\nexport default defineView({\n  universalIdentifier: VIEW_IDS.taskBoard,\n  name: 'Board tâches',\n  objectUniversalIdentifier:\n    STANDARD_OBJECT_UNIVERSAL_IDENTIFIERS.task.universalIdentifier,\n  type: ViewType.KANBAN,\n  icon: 'IconLayoutKanban',\n  position: 1,\n  openRecordIn: ViewOpenRecordIn.SIDE_PANEL,\n  mainGroupByFieldMetadataUniversalIdentifier: TASK_FIELD_IDS.projectStatus,\n  fields: [ /* { universalIdentifier: viewFieldId('01',1,pos), fieldMetadataUniversalIdentifier, position, isVisible, size } */ ],\n  filters: [\n    {\n      universalIdentifier: 'c31b0100-0005-4000-8000-000000000004',\n      fieldMetadataUniversalIdentifier: TASK_FIELD_IDS.project,\n      operand: ViewFilterOperand.IS_NOT_EMPTY,\n      value: '',\n    },\n  ],\n  groups: [\n    { universalIdentifier: 'c31b0100-0007-...0001', fieldValue: 'TODO', isVisible: true, position: 0 },\n    // IN_PROGRESS, DONE\n  ],\n});\n```\n\nView types seen in-tree: `ViewType.TABLE`, `ViewType.KANBAN`, `ViewType.CALENDAR` (with `calendarFieldMetadataUniversalIdentifier` + `ViewCalendarLayout.MONTH`). Supported filter operands include `ViewFilterOperand.IS_NOT_EMPTY`, `IS_IN_PAST`, `IS`, `IS_NOT`.\n\n### 4b. Page layout — `definePageLayout`\n\n`/Users/maxaubert/Projets/A2E Suite/packages/twenty-apps/internal/a2e-documents/src/page-layouts/document.page-layout.ts`:\n\n```ts\nimport { definePageLayout, PageLayoutTabLayoutMode } from 'twenty-sdk/define';\n\nimport { FRONT_COMPONENT_IDS, OBJECT_IDS } from '../constants/universal-identifiers.ts';\n\nexport default definePageLayout({\n  universalIdentifier: 'c31a0100-0008-4000-8000-000000000001',\n  name: 'Document Record Page',\n  type: 'RECORD_PAGE',\n  objectUniversalIdentifier: OBJECT_IDS.document,\n  tabs: [\n    {\n      universalIdentifier: 'c31a0100-0009-4000-8000-000000000001',\n      title: 'Home',\n      position: 10,\n      icon: 'IconNotes',\n      layoutMode: PageLayoutTabLayoutMode.VERTICAL_LIST,\n      widgets: [\n        {\n          universalIdentifier: 'c31a0100-000a-4000-8000-000000000001',\n          title: 'Fields',\n          type: 'FIELDS',\n          configuration: { configurationType: 'FIELDS' },\n        },\n        {\n          universalIdentifier: 'c31a0100-000a-4000-8000-000000000002',\n          title: 'Contenu',\n          type: 'FIELD_RICH_TEXT',\n          objectUniversalIdentifier: OBJECT_IDS.document,\n          configuration: { configurationType: 'FIELD_RICH_TEXT' },\n        },\n        {\n          universalIdentifier: 'c31a0100-000a-4000-8000-000000000004',\n          title: 'Page',\n          type: 'FRONT_COMPONENT',\n          configuration: {\n            configurationType: 'FRONT_COMPONENT',\n            frontComponentUniversalIdentifier: FRONT_COMPONENT_IDS.documentPage,\n          },\n        },\n      ],\n    },\n    {\n      universalIdentifier: 'c31a0100-0009-4000-8000-000000000002',\n      title: 'Timeline',\n      position: 20,\n      icon: 'IconHistory',\n      layoutMode: PageLayoutTabLayoutMode.VERTICAL_LIST,\n      widgets: [\n        {\n          universalIdentifier: 'c31a0100-000a-4000-8000-000000000003',\n          title: 'Timeline',\n          type: 'TIMELINE',\n          configuration: { configurationType: 'TIMELINE' },\n        },\n      ],\n    },\n  ],\n});\n```\n\nWidget types observed: `'FIELDS'`, `'FIELD_RICH_TEXT'` (needs `objectUniversalIdentifier`), `'TIMELINE'`, `'RECORD_TABLE'` (needs `objectUniversalIdentifier`, optionally `configuration.viewUniversalIdentifier`), `'FILES'`, `'FRONT_COMPONENT'`. The project page layout (`a2e-projects/src/page-layouts/project.page-layout.ts`) is the maximal example (5 tabs). A `'RECORD_TABLE'` widget renders whichever view layout it references (table, kanban, etc.), so no extra board component is needed.\n\n### 4c. Navigation menu item — `defineNavigationMenuItem`\n\n`/Users/maxaubert/Projets/A2E Suite/packages/twenty-apps/internal/a2e-documents/src/navigation-menu-items/documents.navigation-menu-item.ts`:\n\n```ts\nimport {\n  defineNavigationMenuItem,\n  NavigationMenuItemType,\n} from 'twenty-sdk/define';\n\nimport { NAVIGATION_MENU_ITEM_IDS, VIEW_IDS } from '../constants/universal-identifiers.ts';\n\nexport default defineNavigationMenuItem({\n  universalIdentifier: NAVIGATION_MENU_ITEM_IDS.documents,\n  name: 'Documents',\n  icon: 'IconNotes',\n  position: 100,\n  type: NavigationMenuItemType.VIEW,\n  viewUniversalIdentifier: VIEW_IDS.allDocuments,\n});\n```\n\nA `NavigationMenuItemType.FOLDER` item omits `viewUniversalIdentifier`; children are `VIEW` items that point back with `folderUniversalIdentifier` (see `a2e-projects/src/navigation-menu-items/my-tasks*.navigation-menu-item.ts`).\n\n### 4d. Command menu item — `defineCommandMenuItem`\n\n`/Users/maxaubert/Projets/A2E Suite/packages/twenty-apps/internal/a2e-documents/src/command-menu-items/create-document.command-menu-item.ts`:\n\n```ts\nimport { defineCommandMenuItem } from 'twenty-sdk/define';\n\nimport { DOCUMENT_BROWSER_FRONT_COMPONENT_UNIVERSAL_IDENTIFIER } from '../front-components/constants.ts';\n\nexport default defineCommandMenuItem({\n  universalIdentifier: 'c31a0000-0011-4000-8000-000000000001',\n  label: 'A2E Documents : créer un document',\n  shortLabel: 'Créer un document',\n  availabilityType: 'GLOBAL',\n  isPinned: true,\n  frontComponentUniversalIdentifier:\n    DOCUMENT_BROWSER_FRONT_COMPONENT_UNIVERSAL_IDENTIFIER,\n});\n```\n\n`availabilityType` is `'GLOBAL'` or `'RECORD_SELECTION'` (the timer command is `RECORD_SELECTION`); `isPinned` is optional. Each command points at a `defineFrontComponent`.\n\n### 4e. Front component (context) — `defineFrontComponent`\n\n`/Users/maxaubert/Projets/A2E Suite/packages/twenty-apps/internal/a2e-documents/src/front-components/document-page.front-component.tsx` (end of file):\n\n```ts\nexport default defineFrontComponent({\n  universalIdentifier: DOCUMENT_PAGE_FRONT_COMPONENT_UNIVERSAL_IDENTIFIER,\n  name: 'document-page',\n  description:\n    'Couverture, plan des titres et sous-pages sur la page d’un document.',\n  component: DocumentPage,\n});\n```\n\nComponents import the Core API binding from `twenty-client-sdk/core` (`new CoreApiClient()`), and React hooks `/ useSelectedRecordIds` from `twenty-sdk/front-component`. Front-component UUIDs are typically declared in `constants/universal-identifiers.ts` (`FRONT_COMPONENT_IDS`); a2e-documents also keeps a single literal in `front-components/constants.ts` — prefer the `FRONT_COMPONENT_IDS` registry (a2e-projects style).\n\n---\n\n## 5. Logic functions and post-install\n\n### 5a. Cron logic function — `defineLogicFunction`\n\n`/Users/maxaubert/Projets/A2E Suite/packages/twenty-apps/internal/a2e-projects/src/logic-functions/purge-trash.logic-function.ts`:\n\n```ts\nimport { defineLogicFunction } from 'twenty-sdk/define';\n\nimport { LOGIC_FUNCTION_IDS } from '../constants/universal-identifiers.ts';\nimport { purgeExpiredTrash } from './handlers/purge-trash-handler.ts';\n\nconst handler = async () => {\n  const result = await purgeExpiredTrash();\n  console.log('[a2e-projects] Corbeille purgée', result);\n  return result;\n};\n\nexport default defineLogicFunction({\n  universalIdentifier: LOGIC_FUNCTION_IDS.purgeTrash,\n  name: 'purge-projects-trash',\n  description:\n    'Purge définitive des projets, jalons, temps et étiquettes archivés depuis plus de 7 jours (miroir du cycle poubelle P3).',\n  timeoutSeconds: 120,\n  cronTriggerSettings: {\n    pattern: '30 3 * * *',\n  },\n  handler,\n});\n```\n\nAn event-triggered function (see `task-human-id.logic-function.ts` and `guard-document-parent-cycle.ts`) uses `eventTriggerSettings` instead of a cron. Logic functions stay thin: business logic lives in `src/lib/*.ts`, the transport/mutation code in `src/logic-functions/handlers/*.ts` (injectable client), and the `.logic-function.ts` file just wires the payload.\n\n### 5b. Post-install — `definePostInstallLogicFunction`\n\n`/Users/maxaubert/Projets/A2E Suite/packages/twenty-apps/internal/a2e-documents/src/logic-functions/post-install.ts` (tail):\n\n```ts\nexport default definePostInstallLogicFunction({\n  universalIdentifier: LOGIC_FUNCTION_IDS.postInstall,\n  name: 'post-install',\n  description:\n    'Prépare A2E Documents : document de bienvenue et bundle de modèles de démarrage (réunion, brief, PRD, entretien).',\n  timeoutSeconds: 120,\n  shouldRunSynchronously: false,\n  handler,\n});\n```\n\nKey requirements visible in both apps:\n- `LOGIC_FUNCTION_IDS.postInstall` must be registered in `universal-identifiers.ts`.\n- The handler must be **idempotent** (reinstall-safe) — a2e-documents diffs existing template titles (`findMissingStarterTemplates`), a2e-projects diffs existing project `key`s (`findMissingStarterProjects`).\n- Client access is `import { CoreApiClient } from 'twenty-client-sdk/core'`; calls are cast `as never` (the generated client is untyped before generation). This pattern recurs everywhere.\n- `shouldRunSynchronously: false` and `shouldRunOnVersionUpgrade` are emitted into `.twenty/output/manifest.json` under `application.postInstallLogicFunction`.\n\n### 5c. Workflow recipe (optional)\n\n`a2e-projects` also has `src/workflow-templates/recurring-task-generator.workflow.ts`. The manifest has no workflow entity; a \"recipe\" is app source data materialized through the native workflow engine, and `workflowActionTriggerSettings` on the logic function is what registers a workflow step. Only needed if chat requires scheduled automations.\n\n---\n\n## 6. Test conventions\n\nTests live in `src/lib/__tests__/*.test.ts` and `src/logic-functions/__tests__/*.test.ts`, run with Node's built-in runner + type stripping:\n\n```\nnode --test --experimental-strip-types \"src/lib/__tests__/*.test.ts\" \"src/logic-functions/__tests__/*.test.ts\"\n```\n\nNode `24.5.0` is required (`--experimental-strip-types` is rejected by Node 20, per `docs/repository-architecture-audit.md` line 638). Test files import with explicit `.ts` extensions.\n\nTwo assertion styles:\n\n1. **Pure-function tests** (`src/lib/__tests__/*.test.ts`): import from `node:assert/strict` and `node:test`, exercise the exported helpers directly. Representative: `/Users/maxaubert/Projets/A2E Suite/packages/twenty-apps/internal/a2e-projects/src/lib/__tests__/trash-retention.test.ts`:\n\n```ts\nimport assert from 'node:assert/strict';\nimport { test } from 'node:test';\n\nimport {\n  TRASH_RETENTION_DAYS,\n  buildArchivePayload,\n  buildRestorePayload,\n  isInTrash,\n  isPastTrashRetention,\n  isRestorable,\n} from '../trash-retention.ts';\n\ntest('the retention window is 7 days, shared by the UI and the cron', () => {\n  assert.equal(TRASH_RETENTION_DAYS, 7);\n});\n\ntest('a live record is not in the corbeille', () => {\n  assert.equal(isInTrash(null), false);\n  assert.equal(isInTrash(undefined), false);\n  assert.equal(isInTrash(''), false);\n  assert.equal(isInTrash('not-a-date'), false);\n});\n// ...\n```\n\n2. **Definition-validation tests** (the manifest graph walk): dynamically `await import()` each declaration module and assert the SDK result envelope. Every `define*` call returns a `DefinitionResult<T>` shaped `{ success: boolean; config: T; errors?: unknown[] }`. The pattern is in `/Users/maxaubert/Projets/A2E Suite/packages/twenty-apps/internal/a2e-projects/src/lib/__tests__/project-object-integrity.test.ts`:\n\n```ts\ntype DefinitionResult<TDefinition> = {\n  success: boolean;\n  config: TDefinition;\n  errors?: unknown[];\n};\n\nconst unwrap = async <TDefinition>(modulePath: string): Promise<TDefinition> => {\n  const module = (await import(modulePath)) as {\n    default: DefinitionResult<TDefinition>;\n  };\n\n  assert.equal(\n    module.default.success,\n    true,\n    `invalid definition: ${modulePath}`,\n  );\n\n  return module.default.config;\n};\n```\n\n`task-field-integrity.test.ts` asserts `module.default.success === true` and walks the whole object/field graph: no duplicate universal identifiers, every relation target object/field resolves, every M2O/O2M pair is symmetric and owned by its target, every label identifier resolves, select option sets kept. `project-object-integrity.test.ts` extends the walk to views, page-layouts, nav items and the role.\n\n`command-availability.test.ts` imports command/logo modules statically and reads `command.success` / `command.config` (not a default import because it imports several). Important: `assert.deepEqual(command.errors, [])`.\n\n3. **Handler tests** (`src/logic-functions/__tests__/*.test.ts`) stub the Core client with a plain object shaped like `Pick<CoreApiClient, 'query' | 'mutation'>`; the generated client is never instantiated (it throws before generation). See `/Users/maxaubert/Projets/A2E Suite/packages/twenty-apps/internal/a2e-projects/src/logic-functions/__tests__/purge-trash-handler.test.ts` and `task-human-id-handler.test.ts`.\n\nCI discovers tests via `package.json` scripts (`.github/workflows/discover-apps.yaml`): `hasTypecheck = Boolean(scripts.typecheck)`, `hasUnit = Boolean(scripts['test:unit'])`, `hasIntegration = Boolean(scripts.test)`. So a new app **must** define `typecheck` and `test:unit` in `package.json` to be exercised by CI. `a2e-documents` currently only gets lint/typecheck in CI (no `test:unit`); do not copy that gap for `a2e-chat`.\n\n---\n\n## 7. package.json scripts and the exact build command\n\nScripts (from `a2e-projects/package.json`):\n\n| Script | Command |\n|---|---|\n| `twenty` | `twenty` |\n| `lint` | `oxlint -c .oxlintrc.json .` |\n| `lint:fix` | `oxlint --fix -c .oxlintrc.json .` |\n| `typecheck` | `tsc --noEmit` |\n| `test:unit` | `node --test --experimental-strip-types \"src/lib/__tests__/*.test.ts\" \"src/logic-functions/__tests__/*.test.ts\"` |\n\nThere is **no `dev:build` script in package.json** — `dev:build` is a subcommand of the `twenty` CLI. The exact build command is run from inside the app directory:\n\n```sh\nnpx twenty dev:build .\n# or equivalently\nyarn twenty dev:build .\n```\n\nFrom the repo root with the built workspace SDK:\n\n```sh\nnode packages/twenty-sdk/dist/cli.cjs dev:build packages/twenty-apps/internal/a2e-chat\n```\n\nPublish/install (from `docs/applications.md` §3, run inside the app dir; `--private` keeps it out of npm):\n\n```sh\nyarn twenty dev:build .\nyarn twenty app:publish . --private --remote scratch\nyarn twenty app:install . --remote scratch\n```\n\n`npx nx lint:diff-with-main a2e-<app>` **does not work** for these apps (they are not Nx projects) — use `yarn lint`/`yarn typecheck`/`yarn test:unit` + `npx twenty dev:build .` as the gates. `npx oxlint --type-aware` is unsupported by the pinned oxlint 0.16.x. Root `.oxfmtrc.jsonc` ignores `**/lib/**`, so formatting lib files needs a lib-inclusive config passed with `-c`.\n\nCI (`.github/workflows/ci-twenty-apps.yaml`) runs, per changed app: `yarn install --immutable`, `yarn lint`, `yarn typecheck` (if present), `yarn test:unit` (if present).\n\n---\n\n## 8. Universal identifier generation, namespacing, and the `c31b*` namespace\n\nThere is **no automatic generator** for app-owned universal identifiers. They are hand-authored, deterministic, and committed forever (the \"additive-only law\"). The two conventions:\n\n### 8a. Toplevel UUIDs generated once\n\n`application.config.ts` `APPLICATION_UNIVERSAL_IDENTIFIER` and the default role's `DEFAULT_FUNCTION_ROLE_UNIVERSAL_IDENTIFIER` are generated with `node -e \"console.log(crypto.randomUUID())\"` and must never change once published/installed. (`README-A2E.md` §2.)\n\n### 8b. App-owned identifiers live in `src/constants/universal-identifiers.ts`\n\nThe namespace scheme is documented in the file header. `a2e-documents` (`c31a`) and `a2e-projects` (`c31b`) use:\n\n```\nc31{app}{OO}00-{KK}00-4000-8000-0000000000{NN}\n```\n\n- `{app}`: `a` = Documents, `b` = Projects.\n- `{OO}`: object index (`00` = app-level, `01` document, `02` project, `03` milestone, `04` projectMember, `05` timeEntry, `06` label, `07` taskLabel; task-extension fields use `01`).\n- `{KK}`: family key:\n  - `0000` object\n  - `0001` own field\n  - `0002` relation field\n  - `0003` view\n  - `0004` view field\n  - `0005` select option\n  - `0006` view sort (and used as view-filter family in a2e-projects)\n  - `0007` view group\n  - `0008` page layout\n  - `0009` page-layout tab\n  - `000a` widget\n  - `0010` navigation menu item\n  - `0011` command menu item\n  - `0012` logic function\n  - `0013` front component\n  - `0014` workflow step (a2e-projects)\n- `{NN}`: trailing counter, hex.\n\n`a2e-projects/src/constants/universal-identifiers.ts` header (verbatim):\n\n```ts\n// Universal identifiers for A2E Projects.\n//\n// One UUIDv4-class identifier per declarable thing, committed forever\n// (additive-only law). The scheme is shaped like A2E Documents' but uses a\n// distinct namespace so both apps install side by side (Documents owns\n// c31a*, Projects owns c31b*):\n// c31b{OO}00-{KK}00-4000-8000-0000000000{NN} where OO is the object index\n// (OBJECT_INDEX below: 02 project, 03 milestone, 04 projectMember,\n// 05 timeEntry, 06 label; 00 = app-level) and KK the family:\n//   0000 object · 0001 own field · 0002 relation field · 0003 view ·\n//   0004 view field · 0005 select option · 0006 view sort ·\n//   0009 page-layout tab · 000a widget · 0010 nav item ·\n//   0011 command menu item · 0012 logic function · 0013 front component\n//\n// Relation identifiers live here so object files never import each other\n// (circular imports resolve to undefined at manifest build time).\n```\n\nThe exported registries (a2e-projects):\n\n```ts\nexport const OBJECT_IDS = {\n  project: 'c31b0200-0000-4000-8000-000000000000',\n  milestone: 'c31b0300-0000-4000-8000-000000000000',\n  projectMember: 'c31b0400-0000-4000-8000-000000000000',\n  timeEntry: 'c31b0500-0000-4000-8000-000000000000',\n  label: 'c31b0600-0000-4000-8000-000000000000',\n  taskLabel: 'c31b0700-0000-4000-8000-000000000000',\n} as const;\n\nexport const RELATION_IDS = { projectLead: 'c31b0200-0002-…0001', /* both sides */ } as const;\nexport const LABEL_IDENTIFIER_IDS = { projectName: 'c31b0200-0001-…0001', /* … */ } as const;\nexport const LOGIC_FUNCTION_IDS = { postInstall: 'c31b0000-0012-…0003', /* … */ } as const;\nexport const TASK_FIELD_IDS = { project: 'c31b0201-0001-…0001', /* standard-task ext fields */ } as const;\nexport const COMMAND_MENU_ITEM_IDS = { createProject: 'c31b0000-0011-…0004', /* … */ } as const;\nexport const NAVIGATION_MENU_ITEM_IDS = { projects: 'c31b0000-0010-…0003', /* … */ } as const;\nexport const FRONT_COMPONENT_IDS = { projectOverview: 'c31b0000-0013-…0006', /* … */ } as const;\nexport const VIEW_IDS = { allProjects: 'c31b0200-0003-…0001', /* … */ } as const;\nexport const OBJECT_INDEX = {\n  milestone: '03', project: '02', projectMember: '04',\n  timeEntry: '05', label: '06', task: '01',\n} as const;\n```\n\nView-field identifiers are **derived positionally**, not listed:\n\n```ts\nexport const viewFieldId = (\n  objectIndex: string,\n  viewIndex: number,\n  position: number,\n): string =>\n  `c31b${objectIndex}00-0004-4000-8000-${viewIndex\n    .toString(16)\n    .padStart(2, '0')}${position.toString(16).padStart(10, '0')}`;\n```\n\na2e-documents' variant is simpler (`viewFieldId(viewIndex, position)` with hardcoded `c31a0100-0004-…`).\n\nThe header comment explains the critical **why**: relation identifiers live in the constants file so object files never import each other — circular imports resolve to `undefined` at manifest build time. Any new relation pair must be declared in `RELATION_IDS` and referenced from both sides.\n\n### 8c. The `c31b*` namespace origin (important for `a2e-chat`)\n\nFrom `docs/plan/phases/phase-04-report.md` (lines 553, 568, 581, 593, 597):\n\n> **Install blocker found and fixed:** the first `app:install` aborted — a2e-projects shared **17 universal identifiers** with A2E Documents (the whole `c31a*` namespace was cloned), so the two apps could never coexist. Approved fix: prefix shift `c31a` → `c31b` across the app (26 files, incl. the generated `viewFieldId` template).\n\nAnd (line 581):\n\n> The `c31b*` namespace and the six live-found API-shape fixes (phase-04 orchestrator entry 2026-09-17) stand.\n\nSo `c31a` = Documents, `c31b` = Projects. `c31c*` is the natural next available `c31*` namespace for `a2e-chat`. `a2e-accounting` deliberately uses a wholly different prefix `b11a*` (it predates/mirrors Bilan's own scheme). `a2e-chat` must pick a namespace that **collides with no committed identifier** in any installed app (Documents/Projects/accounting/real-estate/twenty-partners); `c31c*` is unclaimed in the current tree.\n\n### 8d. Standard object identifier map\n\nThe standard-object map is not per-app; it is `STANDARD_OBJECT_UNIVERSAL_IDENTIFIERS` in `packages/twenty-shared/src/metadata/constants/standard-object-universal-identifiers.constant.ts` (full contents in §3c), re-exported by `twenty-sdk/define`. `packages/twenty-shared/src/metadata/constants/standard-object-fields.constant.ts` maps each standard object's system fields (`createdBy`, etc.), accessed as `STANDARD_OBJECT_UNIVERSAL_IDENTIFIERS.task.fields.createdBy.universalIdentifier`.\n\n---\n\n## 9. `src/lib/` vs `src` root\n\n`src/` root holds only SDK declaration manifests (auto-discovered by the build) plus `application.config.ts`:\n\n- `application.config.ts`, `objects/`, `fields/`, `views/`, `page-layouts/`, `navigation-menu-items/`, `command-menu-items/`, `logic-functions/`, `front-components/`, `roles/`, `workflow-templates/`, and `constants/`.\n- File naming mirrors the entity: `objects/document.object.ts`, `views/all-documents.view.ts`, `page-layouts/document.page-layout.ts`, `navigation-menu-items/documents.navigation-menu-item.ts`, `command-menu-items/create-document.command-menu-item.ts`, `logic-functions/purge-trash.logic-function.ts` (or `post-install.ts`), `front-components/document-page.front-component.tsx`, `roles/default-function.role.ts`, `fields/task-project.field.ts`.\n\n`src/lib/` is the **pure, framework-free, unit-testable business logic layer** — the only place with `__tests__/` co-located, and the only place tests are wired (`src/lib/__tests__/*.test.ts` plus `src/logic-functions/__tests__/*.test.ts`). Its modules never import SDK declaration helpers or React; they are plain TypeScript functions and types. Examples:\n\n| file | responsibility |\n|---|---|\n| `lib/trash-retention.ts` | retention policy as data (`TRASH_RETENTION_DAYS`, `isPastTrashRetention`, payload builders) |\n| `lib/starter-templates.ts` / `lib/starter-projects.ts` | post-install seed content + idempotency diff helpers |\n| `lib/task-human-id.ts` / `lib/task-tree.ts` | pure CAS allocation rules / tree nesting + cycle guards |\n| `lib/project-gantt.ts` / `lib/time-tracker.ts` | pure timeline math / timer state machine + rollups |\n| `lib/document-tree.ts` / `lib/instantiate-template.ts` | tree payload builders / template copy payload |\n| `lib/recurring-task-generator.ts` | pure workflow input validation |\n\nDivision of labor visible throughout: pure rules in `lib/` → thin Core-API code in `logic-functions/handlers/` → declaration/transport wrapper in `logic-functions/*.logic-function.ts`; front components import their pure projection from `lib/` (e.g. `project-overview.front-component.tsx` imports `buildProjectOverviewSummary` from `../lib/project-overview.ts`).\n\n---\n\n## Minimal checklist to scaffold `a2e-chat` (derived, not yet done)\n\nBased on the two references, a new `packages/twenty-apps/internal/a2e-chat/` needs at least:\n\n1. `package.json` (name `a2e-chat`, `twenty-app` keyword, scripts incl. `test:unit`), `tsconfig.json`, `.oxlintrc.json`, `.nvmrc` (`24.5.0`), `.yarnrc.yml` (`nodeLinker: node-modules`), `.gitignore`, and a committed `yarn.lock` after `yarn install`.\n2. `src/application.config.ts` with a **fresh** `APPLICATION_UNIVERSAL_IDENTIFIER`.\n3. `src/roles/default-function.role.ts` with a **fresh** role UUID and least-privilege flags (`canDestroyAllObjectRecords: false`).\n4. `src/constants/universal-identifiers.ts` in an unclaimed namespace (proposed `c31c*`) with `OBJECT_IDS`, `RELATION_IDS`, `LABEL_IDENTIFIER_IDS`, `LOGIC_FUNCTION_IDS`, `COMMAND_MENU_ITEM_IDS`, `NAVIGATION_MENU_ITEM_IDS`, `FRONT_COMPONENT_IDS`, `VIEW_IDS`, and a `viewFieldId` helper.\n5. `src/constants/field-vocabulary.ts` for shared option builders / relation helpers.\n6. At minimum one `src/objects/*.object.ts` (must ship a label identifier field), matching table view(s) in `src/views/`, a record page layout in `src/page-layouts/`, at least one `src/navigation-menu-items/*.navigation-menu-item.ts`, at least two command-menu items (\"Create …\" + \"Go to …\") in `src/command-menu-items/`, and `src/logic-functions/post-install.ts` (idempotent) with an event/cron function as needed. Cross-object and standard-object relations go in `src/fields/*.field.ts`.\n7. `src/lib/*.ts` pure logic + `src/lib/__tests__/*.test.ts` (and optionally `src/logic-functions/__tests__/`) runnable via `yarn test:unit`.\n8. Gates: `yarn lint` → `yarn typecheck` → `yarn test:unit` → `npx twenty dev:build .` (all from the app dir). The `.twenty/` build output is gitignored.\n\nDo not copy `a2e-documents` or `a2e-projects` UUIDs; the phase-04 report records the collision failure that made this an explicit rule.\n</task_result>\n</task>",
