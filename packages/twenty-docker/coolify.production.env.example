# Copy values into a NEW production resource; retain the existing test resource.
# Get the full digest from the successful CD job's Tested A2E image summary.
A2E_IMAGE=ghcr.io/maxx-abrt/a2e-suite@sha256:REPLACE_WITH_TESTED_DIGEST
SERVER_URL=https://REPLACE_WITH_PRODUCTION_DOMAIN
SERVER_BIND_ADDRESS=127.0.0.1
# Ephemeral loopback host port for the Coolify proxy; not "no published port".
# Keep a fixed port instead if a host reverse proxy/tunnel explicitly uses it.
SERVER_PORT=0
PG_DATABASE_NAME=a2e_prod
PG_DATABASE_USER=postgres
# Generate independently: openssl rand -hex 32
PG_DATABASE_PASSWORD=
# Generate each independently: openssl rand -base64 32
ENCRYPTION_KEY=
APP_SECRET=
# Empty on a fresh database; only a real previous key belongs here during rotation.
FALLBACK_ENCRYPTION_KEY=

# Keep these keys stable and store them outside the server in a password manager.
IS_SHARED_DOMAIN_WORKSPACE_ENABLED=true
IS_MULTIWORKSPACE_ENABLED=false
IS_WORKSPACE_CREATION_LIMITED_TO_SERVER_ADMINS=false
LOGIC_FUNCTION_LOCAL_API_URL=http://server:3000
LOGIC_FUNCTION_TYPE=LOCAL
DISABLE_BUNDLED_APP_PROVISIONING=false
REDIS_URL=redis://redis:6379
STORAGE_TYPE=local
# Optional native S3 storage; configure before uploading real data.
STORAGE_S3_REGION=
STORAGE_S3_NAME=
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_PRESIGNED_URL_ENABLED=false

# LOGGER does not deliver mail. Configure SMTP/Resend before enabling verification.
EMAIL_DRIVER=LOGGER
EMAIL_FROM_ADDRESS=noreply@REPLACE_WITH_PRODUCTION_DOMAIN
EMAIL_FROM_NAME=A2E Suite
IS_EMAIL_VERIFICATION_REQUIRED=false
# For native Resend REST delivery, change EMAIL_DRIVER to RESEND and set this key.
# SMTP variables are unnecessary in RESEND mode. Verify the sender domain first.
RESEND_API_KEY=

# Normal boot; recovery flags are optional maintenance controls only.
A2E_RECOVERY_TARGET_DATABASE=
A2E_RECOVERY_APPLY=false
