# Backblaze B2 (preferred — S3-compatible)
# Your endpoint: s3.eu-central-003.backblazeb2.com
# Your bucket: A2E-Drive
# Set these in the Convex Dashboard (NOT here — this file is committed to git)
B2_REGION=eu-central-003
B2_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
B2_KEY_ID=your-key-id
B2_APPLICATION_KEY=your-application-key
B2_BUCKET_NAME=A2E-Drive

# Legacy AWS S3 (fallback if B2 vars are not set)
# AWS_REGION=eu-west-3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=

# Optional: other S3-compatible service (Scaleway, MinIO, Wasabi, ...)
# S3_ENDPOINT=https://s3.fr-par.scw.cloud
# S3_FORCE_PATH_STYLE=false

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Convex Auth
AUTH_SECRET=                          # openssl rand -base64 32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_RESEND_KEY=                      # from https://resend.com/api-keys
AUTH_RESEND_FROM=A2E Money <auth@association2e.org>

# PostgreSQL (Neon, Supabase, or any Postgres)
DATABASE_URL=postgresql://user:password@host:5432/finflow
